# Copy this file to .env and replace all placeholder values.
# Do not commit .env. Use unique, strong passwords.
MYSQL_ROOT_PASSWORD=replace-with-unique-root-password
DB_USERNAME=library_app
DB_PASSWORD=replace-with-unique-app-password
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
